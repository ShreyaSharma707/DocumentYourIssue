<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <div class="form p-10 ">
            <form action="/edit" method="POST">
                <input class="block w-1/4 rounded-lg px-5 py-2 bg-zinc-700 text-white placeholder:text-zinc-400" type="text" name="previous" placeholder="Previous name" value="<%= filename %>">
                <input class="block w-1/4 rounded-lg px-5 py-2 bg-zinc-700 mt-4 text-white placeholder:text-zinc-400" type="text" name="new" placeholder="New name">
                <input type="submit" class=" mt-3 bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded-lg" value="Update name">
            </form>
        </div>
    </div>


</body>
</html>