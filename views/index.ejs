<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <div class="form p-10">
            <form action="/create" method="POST">
                <input class="block w-full rounded-lg px-5 py-2 bg-zinc-700 text-white placeholder:text-zinc-400" type="text" name="title" placeholder="Enter title">
                <input class="block w-full rounded-lg px-5 py-2 bg-zinc-700 mt-4 text-white placeholder:text-zinc-400" type="textarea" name="description" placeholder="Enter description">
                <input type="submit" class=" mt-3 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg" value="Create task">
            </form>
        </div>
        <div class="task p-5  flex flex-wrap gap-3">            
                <% if(files.length>0){%>
                    <% files.forEach((val)=>{%>
                        <div class="bg-zinc-700 p-4 p-3 w-72 rounded-lg">
                            <h1 class="text-white text-lg font-bold"><%= val%></h1>
                            <div>
                            <a class="text-blue-300 text-sm" href="/file/<%= val %>">Task description</a>
                            <a class="text-zinc-400 text-sm ml-3" href="/edit/<%= val %>">edit</a>
                            </div>
                        </div>
                    <%})%>
                <%}else{%>               
                        <h3 class="text-white font-bold">No tasks yet.</h3> 
                <%}%>
                
        </div>
    </div>


</body>
</html>